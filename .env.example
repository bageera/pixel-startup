# Pixel Startup configuration (visual environment: Pixel Office)
# Copy this file to .env and adjust values as needed.

# HTTP server port
PORT=19000

# LiteLLM API URL (OpenAI-compatible inference proxy; node reads LITELLM_*)
LITELLM_API_URL=https://litellm.example.com

# LiteLLM model for AI Director
LITELLM_MODEL=glm-5.3-flash

# Directory for runtime data (logs, cached config, agent messages, etc.)
# Can be absolute or relative to the app directory
PIXEL_DATA_DIR=./data

# --- Agent runtime presence (GET /api/presence) ---
# Hermes Agent install dir (defaults to ~/.hermes)
# HERMES_HOME=/Users/you/.hermes

# OpenClaw gateway (defaults to http://127.0.0.1:18789 — offline if unreachable)
# OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
# OPENCLAW_GATEWAY_TOKEN=

# Admin password for the Pixel dashboard login (REQUIRED — boot refuses without it;
# set PIXEL_ALLOW_NO_PASSWORD=1 for explicit kiosk mode)
DASHBOARD_PASSWORD=***

# API token for automation (bash scripts POST moves/commands as `Authorization: Bearer <token>`)
PIXEL_API_TOKEN=***
# Session cookie signing secret (random per-boot if unset — sessions reset on restart)
# PIXEL_SESSION_SECRET=***
