# G19: Python production container (uv, uvicorn, non-root)
FROM python:3.12-slim AS builder
WORKDIR /app
RUN pip install --no-cache-dir "uv>=0.5"
COPY pyproject.toml uv.lock* ./
COPY src/pixel_startup ./src/pixel_startup
COPY index.html dashboard.html ./
COPY assets ./assets
RUN uv sync --frozen --no-dev --compile-bytecode 2>/dev/null || uv sync --no-dev
FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssh-client && rm -rf /var/lib/apt/lists/*
RUN useradd -r -u 1001 pixel && mkdir -p /app/data && chown -R pixel:pixel /app
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/src /app/src
COPY --from=builder /app/index.html /app/index.html
COPY --from=builder /app/dashboard.html /app/dashboard.html
COPY --from=builder /app/assets /app/assets
COPY pyproject.toml ./
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1
USER pixel
EXPOSE 19000
HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
  CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:19000/healthz',timeout=2)"
CMD ["uvicorn", "pixel_startup.main:app", "--host", "0.0.0.0", "--port", "19000"]
